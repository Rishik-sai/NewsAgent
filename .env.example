# Backend Environment Variables
GROQ_API_KEY="your_groq_api_key_here"
NEWS_API_KEY="your_newsapi_key_here"

# The Database URL is automatically set in docker-compose.yml, but you can override it here if running locally
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/newsagent

JWT_SECRET="generate_a_secure_random_secret_here"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost"
